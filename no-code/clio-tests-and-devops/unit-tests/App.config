		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<!--
				Put this file in tests/<Pkg>/ next to the test csproj. The clio test kit (Libs/*.dll) was built against a Creatio release
				(Terrasoft.Core 8.3.2.4166/8.3.3.1767) possibly newer than the installation the tests compile against
				(TestCoreLibPath, see Directory.Build.props). These redirects let
				the CLR load our locally-available assembly versions instead of failing at runtime with
				FileLoadException. Replace 8.3.2.4199 below with that installation's version; all Terrasoft.* assemblies ship as one
				same-version set.
			-->
			<dependentAssembly>
				<assemblyIdentity name="Terrasoft.Core" publicKeyToken="edaadfbc3b0bb879" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-99.99.99.99" newVersion="8.3.2.4199" />
